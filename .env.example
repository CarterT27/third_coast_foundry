# Copy to .env and fill in. One file for both the page and the Worker.
# Only PUBLIC_* values are bundled into the browser; everything else stays in the Worker.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# LLM: "nvidia" (default, free, slower) or "openrouter" (paid, faster)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
BRAVE_API_KEY=

# Set to true to build the UI with fake data (no Supabase/LLM/search needed)
PUBLIC_USE_FIXTURES=true
